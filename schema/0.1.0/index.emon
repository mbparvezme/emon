#definition(id:string,pattern:string,example:string,description:string,type_list:string[])
#(name:string,version:string,description:string,definitions:#definition[])

="EMON Schema","1.1.0",
"""Official EMON (Efficient Minimal Object Notation) schema definition. Supports nameless roots, suffix-based arrays (type[]), and explicit nulls.""",
[
    {
        definition,
        "^#[a-zA-Z_]\(.\)()?$",
        "#(id:number,name:string,roles:string[])[]",
        "Defines data structure (schema). Root is nameless; arrays use suffix notation.",
        [string,number,bool,int,float,"string[]","number[]","bool[]"]
    },
    {
        record,
        "^=.*$",
        "=1,John,{30,Dhaka},[admin,editor]",
        "Defines data rows matching a schema (starts with =). Values follow positional order.",
        []
    },
    {
        type,
        "string|number|bool|int|float|#<identifier>|type[]",
        "roles:string[]",
        "Defines field data type. Primitives, custom types, or array suffixes are supported.",
        [string,number,bool,int,float,"string[]","number[]","bool[]"]
    },
    {
    multiline_string,
        """".*"""",
        "\"\"\"This is a multiline\ntext block.\"\"\"",
        "Triple-quoted block preserving line breaks. Converts to JSON string with \n.",
        []
    },
    {
    reference,
        "^#\w+$",
        "#profile",
        "Reference to a named nested type definition.",
        []
    },
    {
    comment,
        "^//.*$",
        "// this is a comment",
        "Comments start with // and are ignored by the parser.",
        []
    }
]