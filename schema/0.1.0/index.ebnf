(* EMON: Schema-driven, positional, plain-text data format   *)
(* ========================================================= *)

(* ------------------ BASIC CHARACTER SET ------------------ *)
letter        = "A"…"Z" | "a"…"z" ;
digit         = "0"…"9" ;

(* ----------------- WHITESPACE & COMMENTS ----------------- *)
ws            = { " " | "\t" } ;
new_line      = "\r\n" | "\n" ;
comment       = "//" , { character } , new_line ;
character     = ? any valid Unicode character ? ;

(* -------------------- IDENTIFIERS ------------------------ *)
identifier    = letter , { letter | digit | "_" } ;
type_name     = identifier ;
field_name    = identifier ;

(* ---------------------- LITERALS ------------------------- *)
integer       = [ "+" | "-" ] , digit , { digit } ;
float         = integer , "." , digit , { digit } ;
number        = float | integer ;
boolean       = "true" | "false" ;
null_value    = "null" ;
(* 'null' is a reserved literal and always represents null.
   It is never treated as a string unless explicitly quoted. *)

quoted_string = '"' , { string_char } , '"' ;
string_char =
      ? any character except " or \ or newline ?
    | escaped_sequence ;


escaped_sequence =
      "\" , '"'
    | "\" , "\"
    | "\" , "n"
    | "\" , "t"
    | "\" , "r"
    | "\" , "\" ;

multiline_string = '"""' , { character | new_line } , '"""' ;
bare_string   = letter , { letter | digit | "_" } ;
string        = quoted_string | multiline_string | bare_string ;
(* NOTE: bare_string, number, and boolean may overlap lexically.
   Interpretation is deferred to schema-based typing. *)

(* ---------------------- DOCUMENT ------------------------- *)
(* Version declaration is optional. If omitted, the parser   *)
(* defaults to the latest supported version.                 *)
emon_document = { ws | new_line | comment }, [ version_decl ], { ws | new_line | comment }, schema_block, { schema_block } ;


schema_block = definition, { record } ;
version_decl  = "@version" , "(" , version_number , ")" , new_line ;
version_number = digit , { digit } , "." , digit , { digit } ;

(* ------------------ SCHEMA DEFINITIONS ------------------- *)
definition = "#" , [ type_name ] , "(" , field_list , ")" , [ "[]" ] , new_line ;
(* NOTE: "[]" suffix is only valid on the root (nameless) definition.
   Named type definitions must not use "[]". 
   This constraint is enforced during semantic validation. *)

field_list = field_def , { "," , field_def } ;

(* Optional fields may only be omitted from the end of a record.
   This constraint must be enforced during semantic validation. *)
field_def = field_name , [ "?" ] , ":" , field_type ;

field_type =
      primitive_type
    | custom_type_ref
    | inline_type_def
    ,
    [ "[]" ] ;

primitive_type = "string" | "number" | "bool" ;
custom_type_ref = "#" , type_name ;

(* Inline types are anonymous, non-recursive, non-reusable   *)
inline_type_def = "(" , field_list , ")" ;

(* --------------------- DATA RECORDS ---------------------- *)
(* Values are positional and aligned to schema order         *)
record = "=" , value_list , new_line ;
value_list = value , { "," , value } ;

value =
      raw_token
    | null_value
    | array_instance
    | tuple_instance ;

raw_token = string | number | boolean ;

(* ---------------- TYPE INTERPRETATION -------------------- *)
(* All raw_token values are untyped at parse time.           *)
(* Their final type is determined by the schema.             *)

(* Casting Rules:
   - string: any raw_token is converted to string
   - number: must match numeric format, else error
   - bool: must be 'true' or 'false', else error
   - null: always null (not castable to string)
*)

(* ---------------- ARRAYS & TUPLES ------------------------ *)
(* Tuples are ordered positional aggregates, not maps        *)
array_instance = "[" , ws , [ value_list ] , ws , "]" ;
tuple_instance = "{" , ws , [ value_list ] , ws , "}" ;

(* ---------------- RESERVED FOR FUTURE USE ---------------- *)
(* Identifiers prefixed with "_" (e.g., _checksum, _source)  *)
(* are reserved for future parser-level metadata extensions. *)
(* They are not valid in the current version of EMON.        *)
(* reserved_field = "_" , identifier ;                       *)
