{
  "$schema": "https://mbparvezme.github.io/emon/schema/1.0",
  "name": "EMON Syntax Definition",
  "version": "1.1.0",
  "description": "Defines EMON data notation syntax, structure, and typing rules.",
  "definitions": {
    "definition": {
      "pattern": "^#[a-zA-Z_][a-zA-Z0-9_]*\\(.*\\)(\\[\\])?$",
      "example": "#user(id:number,name:string,profile:#profile,roles:[string])"
    },
    "record": {
      "pattern": "^=.*$",
      "example": "=1,Parvez,{30,Dhaka},[admin,editor]"
    },
    "type": {
      "enum": [
        "string",
        "number",
        "bool",
        "boolean",
        "int",
        "float",
        "[string]",
        "[number]",
        "[bool]",
        "#identifier",
        "(field1:type,field2:type)"
      ]
    },
    "value": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "object" },
        { "type": "array" },
        { "type": "string", "pattern": "^#\\w+$" }
      ]
    },
    "reference": {
      "pattern": "^#\\w+$",
      "example": "#profile"
    },
    "multiline_string": {
      "description": "Triple-quoted multiline text block",
      "example": "\"\"\"This is a\nmultiline\ntext block.\"\"\""
    }
  },
  "structure": {
    "definition": "Schema definition starts with # and may define arrays using []",
    "record": "Data record starts with = and follows the last defined schema",
    "reference": "Use #name to refer to another type",
    "multiline": "Triple quotes (\"\"\") for multiline text values"
  }
}
